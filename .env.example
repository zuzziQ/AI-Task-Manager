# ==============================
# TELEGRAM BOT
# ==============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Danh sách chat_id được phép dùng bot (phân cách bằng dấu phẩy)
# Ví dụ: -100123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=
# Chat ID của admin/group nhận daily summary
TELEGRAM_ADMIN_CHAT_ID=

# ==============================
# PLANE.SO
# ==============================
PLANE_API_KEY=your_plane_api_key_here
# Slug workspace (thấy trên URL: app.plane.so/YOUR_SLUG/...)
PLANE_WORKSPACE_SLUG=your-workspace-slug
# ID của project (UUID, thấy trong URL sau khi chọn project)
PLANE_PROJECT_ID=your-project-uuid-here
# Base URL: https://api.plane.so/api/v1 cho Plane Cloud
# hoặc https://your-domain.com/api/v1 cho self-hosted
PLANE_BASE_URL=https://api.plane.so/api/v1

# ==============================
# GOOGLE SHEETS
# ==============================
# ID của Google Spreadsheet (trong URL sau /d/)
GOOGLE_SHEET_ID=your_google_sheet_id_here
# Đường dẫn đến file service account JSON
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# ==============================
# AI ENGINE (GOOGLE GEMINI)
# ==============================
GEMINI_API_KEY=your_gemini_api_key_here
# Gemma 4 31B via Google AI Studio API
GEMINI_MODEL=gemma-4-31b

# ==============================
# SCHEDULER & TIMEZONE
# ==============================
TIMEZONE=Asia/Ho_Chi_Minh
# Giờ nhắc sáng (format 24h)
MORNING_REMINDER_HOUR=8
MORNING_REMINDER_MINUTE=30
# Giờ nhắc chiều (deadline warning)
AFTERNOON_REMINDER_HOUR=17
AFTERNOON_REMINDER_MINUTE=0
